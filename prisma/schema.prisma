generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String?
  googleId  String?   @unique
  phone     String?
  role      Role      @default(user)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  bookings         Booking[] @relation("UserBookings")
  approvedBookings Booking[] @relation("ApprovedBookings")
}

enum Role {
  admin
  manager
  user
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())

  packages Package[]
}

model Package {
  id            Int       @id @default(autoincrement())
  name          String
  description   String?
  price         Float
  category      String?
  categoryId    Int?
  images        String[]
  features      String[]
  duration      String?
  availableDays String[]
  lynkUrl       String?
  isActive      Boolean   @default(true)
  operatingStartTime String   @default("08:00") // ✅ NEW
  operatingEndTime   String   @default("17:00") // ✅ NEW
  createdAt     DateTime  @default(now())

  bookings    Booking[]
  backgrounds PackageBackground[]
   studios     Studio[]  @relation("PackageStudios") // ✅ NEW
   categoryRef Category? @relation(fields: [categoryId], references: [id]) // ✅ NEW
}

model PackageBackground {
  id          Int      @id @default(autoincrement())
  name        String
  imageUrl    String?
  isAvailable Boolean  @default(true)
  packageId   Int
  createdAt   DateTime @default(now())

  package  Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  bookings Booking[]
}

model TimeSlot {
  id        Int       @id @default(autoincrement())
  status    String    @default("available")
  startTime String?
  endTime   String?
  date      DateTime?
  createdAt DateTime  @default(now())

  bookings Booking[]
}

// ✅ NEW: Studio 1 / Studio 2
model Studio {
  id        Int       @id @default(autoincrement())
  key       String    @unique // "studio1" | "studio2"
  name      String
  note      String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  bookings Booking[]
  packages Package[] @relation("PackageStudios") // ✅ NEW

}

model Booking {
  id              Int       @id @default(autoincrement())
  userId          Int
  packageId       Int?
  backgroundId    Int?
  slotId          Int?
  studioId        Int?      // ✅ NEW
  bookingDate     DateTime?
  bookingTime     String?
  userName        String?
  userPhone       String?
  userEmail       String?
  notes           String?
  totalPrice      Float?
  status          String    @default("pending")
  paymentStatus   String    @default("unpaid")
  cancelReason    String?
  expiresAt       DateTime?
  approvedById    Int?
  approvedAt      DateTime?
  paymentDeadline DateTime?

  photoPickupDate   DateTime?
  photoPickupBy     String?
  photoPickupNotes  String?
  photoPickupStatus String?   @default("belum_diambil")

  calendarEvents Json?

  createdAt DateTime @default(now())

  user       User               @relation("UserBookings", fields: [userId], references: [id])
  package    Package?           @relation(fields: [packageId], references: [id])
  background PackageBackground? @relation(fields: [backgroundId], references: [id])
  slot       TimeSlot?          @relation(fields: [slotId], references: [id])
  studio     Studio?            @relation(fields: [studioId], references: [id]) // ✅ NEW
  approvedBy User?              @relation("ApprovedBookings", fields: [approvedById], references: [id])
}

model LoginBackground {
  id        Int      @id @default(autoincrement())
  url       String
  type      String   @default("image")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}
model EmailTemplate {
  id         Int      @id @default(autoincrement())
  key        String   @unique
  subject    String
  bodyHtml   String
  footerHtml String
  updatedAt  DateTime @updatedAt
}